{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuity-agent.local/schemas/continuity-v1.schema.json",
  "title": "Continuity Agent v1 data contracts",
  "description": "Reference schema. Select a definition with $ref, for example #/$defs/AuditRequest.",
  "$defs": {
    "Rule": {
      "type": "object",
      "required": ["id", "text", "severity"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "check": {"type": "string"},
        "severity": {
          "enum": ["local_fix", "regenerate", "human_review"]
        },
        "note": {"type": "string"},
        "only_shots": {
          "type": "array",
          "items": {"type": ["string", "integer"]}
        },
        "scope_locations": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "NormalizedCrop": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "IdentityReference": {
      "type": "object",
      "required": ["asset_path", "rule_id"],
      "properties": {
        "asset_path": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string", "minLength": 1},
        "crop": {"$ref": "#/$defs/NormalizedCrop"},
        "reject_below": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.45
        },
        "review_below": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.62
        }
      },
      "additionalProperties": false
    },
    "CanonDocument": {
      "type": "object",
      "required": ["meta", "characters", "locations", "shots"],
      "properties": {
        "meta": {
          "type": "object",
          "required": ["contract_version", "version"],
          "properties": {
            "contract_version": {"const": "1.0"},
            "version": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        },
        "characters": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "rules": {
                "type": "array",
                "items": {"$ref": "#/$defs/Rule"}
              },
              "identity_reference": {"$ref": "#/$defs/IdentityReference"}
            },
            "additionalProperties": true
          }
        },
        "locations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "rules": {
                "type": "array",
                "items": {"$ref": "#/$defs/Rule"}
              }
            },
            "additionalProperties": true
          }
        },
        "shots": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "properties": {
              "location": {"type": ["string", "null"]},
              "rules": {
                "type": "array",
                "items": {"$ref": "#/$defs/Rule"}
              },
              "identity_crops": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/NormalizedCrop"
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "MediaInput": {
      "type": "object",
      "required": ["kind", "paths"],
      "properties": {
        "kind": {"enum": ["video", "image_sequence"]},
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "timestamps_s": {
          "type": "array",
          "items": {"type": "number", "minimum": 0}
        }
      },
      "additionalProperties": false
    },
    "ShotInput": {
      "type": "object",
      "required": ["shot_id", "media"],
      "properties": {
        "shot_id": {"type": "string", "minLength": 1},
        "media": {"$ref": "#/$defs/MediaInput"}
      },
      "additionalProperties": false
    },
    "AuditRequest": {
      "type": "object",
      "required": ["contract_version", "job_id", "canon_path", "shots"],
      "properties": {
        "contract_version": {"const": "1.0"},
        "job_id": {"type": "string", "minLength": 1},
        "canon_path": {"type": "string", "minLength": 1},
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/ShotInput"}
        },
        "options": {
          "type": "object",
          "properties": {
            "sample_count": {
              "type": "integer",
              "minimum": 3,
              "maximum": 7
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "EvidenceAsset": {
      "type": "object",
      "required": ["evidence_id", "kind", "path", "label"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["source_frame", "canon_frame", "comparison"]},
        "path": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "timestamp_s": {"type": "number", "minimum": 0},
        "source_media_id": {"type": "string"}
      },
      "additionalProperties": false
    },
    "AuditIssue": {
      "type": "object",
      "required": [
        "rule_id",
        "category",
        "severity",
        "confidence",
        "evidence",
        "rule",
        "minimal_fix",
        "evidence_ids"
      ],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "severity": {
          "enum": ["local_fix", "regenerate", "human_review"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {"type": "string", "minLength": 1},
        "rule": {"type": "string", "minLength": 1},
        "note": {"type": "string"},
        "minimal_fix": {"type": "string", "minLength": 1},
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "requires_confirmation": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "AuditResult": {
      "type": "object",
      "required": [
        "contract_version",
        "shot_id",
        "canon_version",
        "decision",
        "score",
        "issues",
        "evidence_assets",
        "media_kind",
        "api_reviewed",
        "needs_human_review",
        "metrics",
        "video_timestamps_s",
        "api_retries",
        "rule_count"
      ],
      "properties": {
        "contract_version": {"const": "1.0"},
        "shot_id": {"type": "string", "minLength": 1},
        "canon_version": {"type": "string", "minLength": 1},
        "decision": {
          "enum": ["PASS", "LOCAL FIX", "REGENERATE", "HUMAN REVIEW", "SKIP"]
        },
        "score": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "issues": {
          "type": "array",
          "items": {"$ref": "#/$defs/AuditIssue"}
        },
        "evidence_assets": {
          "type": "array",
          "items": {"$ref": "#/$defs/EvidenceAsset"}
        },
        "media_kind": {
          "enum": ["text", "image", "image_sequence", "video"]
        },
        "api_reviewed": {"type": "boolean"},
        "needs_human_review": {"type": "boolean"},
        "metrics": {"type": "object"},
        "video_timestamps_s": {
          "type": "array",
          "items": {"type": "number", "minimum": 0}
        },
        "api_retries": {"type": "integer", "minimum": 0},
        "rule_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    }
  }
}
