{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuity-agent.local/schemas/v1-schedule-v1.schema.json",
  "title": "Continuity Agent v1 14-day schedule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schedule_version",
    "title",
    "duration_days",
    "day_labels_are_relative",
    "success_metric",
    "hard_gate_days",
    "days"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schedule_version": {"const": "1.0"},
    "title": {"type": "string", "minLength": 1},
    "duration_days": {"const": 14},
    "day_labels_are_relative": {"const": true},
    "success_metric": {"type": "string", "minLength": 1},
    "hard_gate_days": {
      "type": "array",
      "prefixItems": [{"const": 5}, {"const": 7}, {"const": 11}],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "days": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {"$ref": "#/$defs/day"}
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "description"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "description": {"type": "string"}
      }
    },
    "evidenceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "label", "paths"],
      "properties": {
        "outcome": {"enum": ["pass", "fallback"]},
        "label": {"type": "string", "minLength": 1},
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/relativePath"}
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard", "evidence_sets", "failure_action"],
      "properties": {
        "hard": {"const": true},
        "evidence_sets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/evidenceSet"}
        },
        "failure_action": {"type": "string", "minLength": 1}
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "day",
        "title",
        "objective",
        "tasks",
        "deliverables",
        "depends_on",
        "gate"
      ],
      "properties": {
        "day": {"type": "integer", "minimum": 1, "maximum": 14},
        "title": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "deliverables": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/deliverable"}
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 13}
        },
        "gate": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/gate"}]
        }
      }
    }
  }
}
